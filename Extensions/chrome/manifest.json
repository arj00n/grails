{
  "manifest_version": 3,
  "name": "Save to Grails",
  "version": "0.2.0",
  "description": "Send images, videos, links and pages to your Grails library on this Mac.",
  "minimum_chrome_version": "110",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Grails"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save this page to Grails"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
